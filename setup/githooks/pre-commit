#!/usr/bin/env bash
# Pre-commit hook: scan the staged files for secrets, lint them, and catch lint
# and build shortcuts before they reach a commit. Install it from the repo root with:
#   mkdir -p .githooks && cp setup/githooks/pre-commit .githooks/ && git config core.hooksPath .githooks
# See setup/lint.md, setup/security.md, setup/api.md, and setup/build.md.
set -uo pipefail

# <!-- TAILOR: your linter. Each command gets the staged files that match PATTERN. -->
LINT='ruff check --output-format concise'
FORMAT_CHECK='ruff format --check'
PATTERN='\.py$'

# <!-- TAILOR: API spec checks from setup/api.md. Leave both empty if the project has no API spec. -->
SPEC_LINT=''
SPEC_DIFF=''

status=0

# Secrets first. Needs gitleaks; without it the commit is blocked.
.agents/shared/secret-scan.sh --staged >/dev/null || {
  .agents/shared/secret-scan.sh --staged | grep '^FAIL'
  status=1
}

staged="$(git diff --cached --name-only --diff-filter=ACMR | grep -E "$PATTERN" || true)"
if [ -n "$staged" ]; then
  # shellcheck disable=SC2086
  $LINT $staged || status=1
  # shellcheck disable=SC2086
  $FORMAT_CHECK $staged || status=1
fi

if [ -n "$SPEC_LINT" ]; then
  $SPEC_LINT >/dev/null 2>&1 || {
    $SPEC_LINT 2>&1 | grep -E ' error ' | head -20
    echo "FAIL: API spec lint found errors."
    status=1
  }
fi
if [ -n "$SPEC_DIFF" ]; then
  $SPEC_DIFF >/dev/null || {
    $SPEC_DIFF | grep -E '^(FAIL|NEEDS APPROVAL)'
    status=1
  }
fi

.agents/shared/lint-guard.sh >/dev/null || {
  .agents/shared/lint-guard.sh | grep '^FAIL'
  status=1
}

.agents/shared/build-guard.sh >/dev/null || {
  .agents/shared/build-guard.sh | grep '^FAIL'
  status=1
}

.agents/shared/context-lint.sh >/dev/null || {
  .agents/shared/context-lint.sh | grep '^FAIL'
  status=1
}

if [ "$status" -ne 0 ]; then
  echo
  echo "Commit blocked. Fix the problems above and commit again."
  echo "Agents: never skip this hook. Ask a human if a rule looks wrong."
fi
exit "$status"
